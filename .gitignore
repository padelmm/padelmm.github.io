# Dependencies
node_modules/

# Support files
docs/

# Build output
dist/
build/
.vite/

# Environment files — NEVER commit secrets, API keys, or tokens
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Cursor IDE — ignore personal state (mcp.json, history, etc.) but
# keep project-scoped skills tracked so they travel with the repo.
# Important: ignore the *contents* of .cursor/, not the directory
# itself, so the negation below can re-include the skills subtree.
/.cursor/*
!/.cursor/skills/

# TypeScript incremental build cache
*.tsbuildinfo

# Misc
coverage/
.cache/
.parcel-cache/
.eslintcache

# One-off tool configs — never commit
.email-rewrite.mailmap
.mailmap.local
