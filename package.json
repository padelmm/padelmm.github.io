{
  "name": "padel-mix-match",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "description": "Mix & Match for padel evenings — by Alex K. Mobile-first PWA to run a Padel Mix & Match session.",
  "author": "Alex K (https://github.com/sedoychel)",
  "license": "MIT",
  "homepage": "https://padelmm.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/padelmm/padelmm.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/padelmm/padelmm.github.io/issues"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "decode-share": "tsx scripts/decode-share.ts",
    "simulate": "tsx scripts/simulate-session.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.10.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.1.8"
  }
}
